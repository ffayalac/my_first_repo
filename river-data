    def browse_input_dir(self):
        path = filedialog.askdirectory()
        if path: self.input_dir_var.set(path)

    def browse_mask_path(self):
        path = filedialog.askopenfilename(filetypes=[("Archivos ASCII Grid", "*.asc")])
        if path: self.mask_path_var.set(path)

    def browse_output_dir(self):
        path = filedialog.askdirectory()
        if path: self.output_dir_var.set(path)

    def log(self, message):
        self.log_text.insert(tk.END, message + "\n")
        self.log_text.see(tk.END)

    def read_asc_bbox(self, asc_path):
        with open(asc_path, 'r') as f:
            lines = f.readlines()
        ncols = int(lines[0].split()[1])
        nrows = int(lines[1].split()[1])
        xll = float(lines[2].split()[1])
        yll = float(lines[3].split()[1])
        cellsize = float(lines[4].split()[1])
        
        min_x = xll
        max_x = xll + (ncols * cellsize)
        min_y = yll
        max_y = yll + (nrows * cellsize)
        return min_x, min_y, max_x, max_y

    def start_processing(self):
        os.makedirs(self.input_dir_var.get(), exist_ok=True)
        os.makedirs(self.output_dir_var.get(), exist_ok=True)

        self.btn_run.config(state=tk.DISABLED)
        self.progress.start(10)
        self.log_text.delete(1.0, tk.END)

        thread = threading.Thread(target=self.run_process_thread, daemon=True)
        thread.start()

    def run_process_thread(self):
        class StdoutRedirector:
            def __init__(self, gui): self.gui = gui
            def write(self, text):
                if text.strip(): self.gui.root.after(0, self.gui.log, text.rstrip())
            def flush(self): pass

        sys.stdout = StdoutRedirector(self)
        try:
            self.download_sentinel()
            print("\n=======================================")
            print("DESCARGA COMPLETADA. INICIANDO RECORTE A MÁSCARA DTM...")
            print("=======================================")
            
            count = process_raster_directory(
                input_dir=self.input_dir_var.get(),
                mask_path=self.mask_path_var.get(),
                output_dir=self.output_dir_var.get(),
                season_filter=self.season_var.get(),
                verbose=True
            )
            self.root.after(0, self.on_process_complete, True, f"Proceso completado con éxito. {count} archivos ASC generados.")
        except Exception as e:
            self.root.after(0, self.on_process_complete, False, f"Ocurrió un error general:\n{str(e)}")
        finally:
            sys.stdout = sys.__stdout__

    def download_sentinel(self):
        client_id = self.client_id_var.get().strip()
        client_secret = self.client_secret_var.get().strip()

        if not client_id or not client_secret:
            raise ValueError("Por favor introduce las credenciales Client ID y Client Secret de Copernicus Data Space.")

        print("Autenticando en Copernicus Data Space Ecosystem (sh.dataspace.copernicus.eu)...")
        
        config = SHConfig()
        config.sh_client_id = client_id
        config.sh_client_secret = client_secret
        config.sh_base_url = "https://sh.dataspace.copernicus.eu"
        config.sh_token_url = "https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"
        
        print("Leyendo coordenadas de tu máscara DTM...")
        min_x, min_y, max_x, max_y = self.read_asc_bbox(self.mask_path_var.get())
        
        epsg_code = self.epsg_var.get().strip()
        roi_bbox = BBox(bbox=[min_x, min_y, max_x, max_y], crs=CRS(f"EPSG:{epsg_code}"))
        size = bbox_to_dimensions(roi_bbox, resolution=10)

        # Evalscript v3 para cálculo de NDVI directo en servidor Copernicus
        evalscript = """
        //VERSION=3
        function setup() {
            return {
                input: ["B04", "B08", "dataMask"],
                output: { id: "default", bands: 1, sampleType: "FLOAT32" }
            };
        }
        function evaluatePixel(sample) {
            // Si el satélite detecta que no hay datos válidos (bordes del satélite)
            if (sample.dataMask === 0) return [-9999];
            
            let ndvi = (sample.B08 - sample.B04) / (sample.B08 + sample.B04);
            
            // Si la fórmula da error o valores irreales por nubes densas
            if (ndvi <= -0.9 || isNaN(ndvi)) return [-9999];
            
            return [ndvi]; 
        }
        """
        
        year_start = int(self.year_start_var.get())
        year_end = int(self.year_end_var.get())
        max_cc = float(self.max_clouds_var.get())
        selected_season = self.season_var.get().lower().replace('otoño', 'otono')

        all_seasons = {
            'invierno': [(1,1), (2,1), (3,1)],
            'primavera': [(4,1), (5,1), (6,1)],
            'verano': [(7,1), (8,1), (9,1)],
            'otono': [(10,1), (11,1), (12,1)]
        }
        
        if selected_season != 'todas':
            seasons_to_process = {selected_season: all_seasons.get(selected_season, all_seasons['otono'])}
        else:
            seasons_to_process = all_seasons

        base_input_dir = self.input_dir_var.get()

        for year in range(year_start, year_end + 1):
            for season, start_dates in seasons_to_process.items():
                season_dir_name = 'otoño' if season == 'otono' else season
                print(f"\n--- Buscando estación [{season_dir_name.upper()}] - Año {year} ---")
                
                # Crear subcarpeta estacional para mantener todo organizado desde la descarga
                season_input_folder = os.path.join(base_input_dir, season_dir_name)
                os.makedirs(season_input_folder, exist_ok=True)

                for i, (month, day) in enumerate(start_dates):
                    start_time = f"{year}-{month:02d}-{day:02d}"
                    end_time_dt = datetime(year, month, day) + timedelta(days=25)
                    end_time = end_time_dt.strftime("%Y-%m-%d")
                    
                    filename = f"NDVI_{year}_{season_dir_name}_mes{month:02d}.tif"
                    filepath = os.path.join(season_input_folder, filename)
                    
                    if os.path.exists(filepath):
                        print(f"✓ Ya existe {filename}, saltando descarga...")
                        continue
                        
                    print(f"Descargando mes {month:02d} ({start_time} al {end_time})...")
                    
                    input_data_raw = [{
                        "type": "sentinel-2-l2a",
                        "dataFilter": {
                            "timeRange": {
                                "from": f"{start_time}T00:00:00Z",
                                "to": f"{end_time}T23:59:59Z"
                            },
                            "maxCloudCoverage": max_cc,
                            "mosaickingOrder": "leastCC"
                        }
                    }]
                    
                    responses_raw = [{
                        "identifier": "default",
                        "format": {"type": "image/tiff"}
                    }]
                    
                    request = SentinelHubRequest(
                        evalscript=evalscript,
                        input_data=input_data_raw,
                        responses=responses_raw,
                        bbox=roi_bbox,
                        size=size,
                        config=config
                    )
                    
                    try:
                        response = request.get_data(decode_data=False) 
                        if response and len(response) > 0:
                            file_bytes = response[0].content 
                            if len(file_bytes) < 1000 and (b'error' in file_bytes.lower() or b'html' in file_bytes.lower()):
                                print(f"❌ Error devuelto por Copernicus: {file_bytes.decode('utf-8', errors='ignore')}")
                            else:
                                with open(filepath, 'wb') as f:
                                    f.write(file_bytes)
                                print(f"✅ Guardado con éxito en subcarpeta '{season_dir_name}': {filename}")
                    except Exception as e:
                        print(f"❌ Error de conexión al descargar {filename}: {str(e)}")

    def on_process_complete(self, success, message):
        self.progress.stop()
        self.btn_run.config(state=tk.NORMAL)
        if success:
            messagebox.showinfo("Éxito", message)
        else:
            messagebox.showerror("Error", f"Ocurrió un error:\n{message}")

